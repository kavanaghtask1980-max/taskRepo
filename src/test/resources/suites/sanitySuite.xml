<?xml version="1.0" encoding="UTF-8"?>
<suite name="SanitySuite">
    <!-- Optional Parallel Execution:
    <suite name="SanitySuite" parallel="tests" thread-count="2">
    -->

    <!-- Optional Suite-Level Browser Override (defaults to @Optional("Chrome") in BaseTest):
    <parameter name="browser" value="Chrome" />
    -->

    <test name="Sanity - Global Search and Core Navigation (Chrome)">
        <!-- Optional Test-Level Browser Override:
        <parameter name="browser" value="Chrome" />
        -->
        <classes>
            <class name="tests.sanity.JenkinsSanityTests" />
            <class name="tests.api.JenkinsApiContractTests" />
            <class name="tests.negative.NegativeValidationTests" />
            <class name="tests.security.SecurityAccessTests" />
        </classes>
    </test>

    <!-- Optional Parallel Cross-Browser Block:
    <test name="Sanity - Global Search and Core Navigation (Edge)">
        <parameter name="browser" value="Edge" />
        <classes>
            <class name="tests.sanity.JenkinsSanityTests" />
        </classes>
    </test>
    -->
</suite>
